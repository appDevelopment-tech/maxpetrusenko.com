# Local dev secrets for `wrangler dev`. Copy to .dev.vars and fill in real values.
# .dev.vars itself is gitignored; never commit real keys.
ADMIN_TOKEN=change-me
RESEND_API_KEY=re_placeholder
# Stripe coupon id (10% off, duration=once). Unique CI10-XXXXXX codes are minted on it.
CI_ONE_EVENT_COUPON_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
STRIPE_SECRET_KEY=sk_test_placeholder
# Twilio SMS for the discount code. Doppler api_keys/dev: BLINDFOLD_DANCE_TWILIO_ACCOUNT_SID,
# BLINDFOLD_DANCE_TWILIO_AUTH_TOKEN, BLINDFOLD_DANCE_TWILIO_PHONE_NUMBER (toll-free +1 833).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Signs the resubscribe confirmation links (any long random string).
CI_CONFIRM_SECRET=
