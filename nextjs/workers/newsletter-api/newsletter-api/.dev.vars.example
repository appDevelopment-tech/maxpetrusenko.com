# Local dev secrets for `wrangler dev`. Copy to .dev.vars and fill in real values.
# .dev.vars itself is gitignored; never commit real keys.
ADMIN_TOKEN=change-me
RESEND_API_KEY=re_placeholder
# Stripe coupon id (10% off, duration=once). Unique CI10-XXXXXX codes are minted on it.
CI_ONE_EVENT_COUPON_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
STRIPE_SECRET_KEY=sk_test_placeholder
# Stripe coupon (percent_off 20, duration once) for the monthly personal codes; create it with tools/create_monthly_coupon.sh.
CI_MONTHLY_COUPON_ID=
# Keys the hash of an emailed one-time code (any long random string, e.g. openssl rand -hex 32).
CI_CONFIRM_SECRET=
# Twilio Verify sends the text one-time code. Doppler api_keys/dev: BLINDFOLD_DANCE_TWILIO_ACCOUNT_SID,
# BLINDFOLD_DANCE_TWILIO_AUTH_TOKEN. Create the service once with tools/create_verify_service.sh.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Ticketing (webhook + QR). Test mode locally: run `stripe listen --forward-to localhost:8787/api/stripe/webhook`
# and paste the whsec_ it prints. Prod: the signing secret of the live webhook endpoint (Stripe Dashboard,
# events checkout.session.completed + checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=
# Derives the unguessable ticket ids (any long random string, e.g. openssl rand -hex 32). Changing it
# orphans issued QR codes, so set it once per environment and keep it.
TICKET_SECRET=
# Optional: URL prefix the QR encodes. Default https://miamicontactimprov.com/checkin/
CHECKIN_BASE_URL=
