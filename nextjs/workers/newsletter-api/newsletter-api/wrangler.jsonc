/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsletter-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-18",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"RESEND_AUDIENCE_ID": "6da7e1c7-6fe5-446d-b306-00a52f5b9d07"
	},
	"ratelimits": [
		{ "name": "SUBSCRIBE_LIMITER", "namespace_id": "48210", "simple": { "limit": 10, "period": 60 } }
	],
	"kv_namespaces": [
		{ "binding": "EMAIL_SUBS", "id": "90a570d807f04bc4abb9b46282291e5b" }
	]
}
