/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsletter-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-18",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"RESEND_AUDIENCE_ID": "6da7e1c7-6fe5-446d-b306-00a52f5b9d07",
		// Must match the STRIPE_SECRET_KEY prefix (sk_test_ / sk_live_). Flip to
		// "live" only in the go-live step, together with the live key.
		"STRIPE_MODE": "test"
	},
	// Workers AI: reads Community $15 screenshots (src/verify.ts).
	"ai": { "binding": "AI" },
	// ~10 requests per minute per client IP on /api/* (src/http.ts).
	"ratelimits": [
		{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	],
	"kv_namespaces": [
		{ "binding": "EMAIL_SUBS", "id": "90a570d807f04bc4abb9b46282291e5b" }
	],
	// Preview Worker for Stripe TEST mode only: own name, own KV, own secrets
	// (STRIPE_SECRET_KEY sk_test_, STRIPE_WEBHOOK_SECRET from a test-mode endpoint).
	// No Resend vars, so it never emails anyone. Deploy: wrangler deploy --env preview
	"env": {
		"preview": {
			"name": "newsletter-api-preview",
			"vars": {
				"STRIPE_MODE": "test",
				"SITE_URL": "https://mci-pricing-preview.pages.dev",
				"EXTRA_ORIGINS": "https://mci-pricing-preview.pages.dev"
			},
			"ai": { "binding": "AI" },
			"ratelimits": [
				{ "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
			],
			"kv_namespaces": [
				{ "binding": "EMAIL_SUBS", "id": "78056955f4ad43de8190384c997f5e75" },
				{ "binding": "AMBASSADORS", "id": "3bb91b4d80a745b2bdecbff8c688bdf2" },
				{ "binding": "IDEAS", "id": "e6ebdfac729243db906d68a228eb076a" },
				{ "binding": "COMMUNITY", "id": "a61d4811e5f841f2aa8f0419a6c38404" }
			]
		}
	}
}
